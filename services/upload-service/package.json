{
  "name": "upload-service",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start:dist": "node dist/src/main.js",
    "start": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint --fix \"{src,test}/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern=test/unit --testRegex=.*\\.unit-spec\\.ts$ --passWithNoTests",
    "test:integration": "jest --testPathPattern=test/integration --testRegex=.*\\.integration-spec\\.ts$ --passWithNoTests",
    "test:e2e": "jest --config test/e2e/jest-e2e.json --passWithNoTests",
    "prisma:generate": "dotenv -e .env -- prisma generate --config ../../libs/common/src/config/prisma.config.ts",
    "prisma:migrate:reset": "dotenv -e .env.prod -- prisma migrate reset --config ../../libs/common/src/config/prisma.config.ts",
    "prisma:migrate:create": "dotenv -e .env.prod -- prisma migrate dev --create-only --config ../../libs/common/src/config/prisma.config.ts",
    "prisma:db:push": "dotenv -e .env -- prisma db push --config ../../libs/common/src/config/prisma.config.ts --accept-data-loss",
    "prisma:migrate:deploy:prod": "dotenv -e .env.prod -- prisma migrate deploy --config ../../libs/common/src/config/prisma.config.ts",
    "dev:prod": "cross-env PORT=3005 UPLOAD_WORKERS_ENABLED=false dotenv -e .env.prod -- nest start --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.617.0",
    "@aws-sdk/s3-request-presigner": "^3.617.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@libs/common": "^1.0.0",
    "@libs/contracts": "^1.0.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.6.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "amqp-connection-manager": "^5.0.0",
    "bullmq": "^5.58.5",
    "cache-manager": "6.4.0",
    "cache-manager-ioredis-yet": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.8.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.10.1",
    "keyv": "^5.6.0",
    "mammoth": "^1.12.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.19.15",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  }
}
