{
  "name": "interaction-service",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start:dist": "node dist/src/main.js",
    "start": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint --fix \"{src,test}/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern=test/unit --testRegex=.*\\.unit-spec\\.ts$ --passWithNoTests",
    "test:integration": "jest --testPathPattern=test/integration --testRegex=.*\\.integration-spec\\.ts$ --passWithNoTests",
    "test:e2e": "jest --config test/e2e/jest-e2e.json --passWithNoTests",
    "dev:prod": "dotenv -e .env.prod -- nest start --watch"
  },
  "dependencies": {
    "@libs/common": "^1.0.0",
    "@libs/contracts": "^1.0.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/mongoose": "^11.0.4",
    "mongoose": "^9.3.3",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/terminus": "^11.1.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@types/node": "^22.19.15",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  }
}
